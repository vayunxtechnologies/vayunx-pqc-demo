# =============================================================================
# VayunX PQC demo — environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values, then run `docker compose up`.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real values.

# Public domain the demo is served on. Must have a DNS A/AAAA record pointing
# at this EC2 instance's public IP BEFORE first boot, so Caddy can complete the
# Let's Encrypt ACME (HTTP-01) challenge over port 80.
DOMAIN=sampledemo.vayunx.com

# Admin/ops email used for the Let's Encrypt ACME account (expiry notices, etc.).
TLS_EMAIL=security@vayunx.com

# App crypto posture advertised in the app's own UI/API.
#   classical = pre-quantum (default)
#   pqc       = post-quantum ready
# NOTE: the HOST TLS-scan posture is driven by which Caddyfile is active
# (proxy/Caddyfile classical vs proxy/Caddyfile.pqc); the Makefile targets
# `classical` / `pqc` keep this value and the Caddyfile in sync.
SECURITY_PROFILE=classical

# Optional: name of the app's session cookie.
SESSION_COOKIE=vayunx_demo
